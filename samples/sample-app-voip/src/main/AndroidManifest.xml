<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hardware features (not required, so app works on devices without camera/mic) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Required permissions for video calling -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service permissions for ongoing calls -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".VoIPApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SampleCallsVoIP">

        <!-- Splash Screen - Entry Point -->
        <activity
            android:name=".ui.activity.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SampleCallsVoIP.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- App Credentials Screen -->
        <activity
            android:name=".ui.activity.AppCredentialsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Login Screen -->
        <activity
            android:name=".ui.activity.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Home Screen - Tabbed (Users + Call Logs) -->
        <activity
            android:name=".ui.activity.HomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- User Detail / Profile Screen -->
        <activity
            android:name=".ui.activity.UserDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Outgoing Call Screen -->
        <activity
            android:name=".ui.activity.OutgoingCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <!-- Incoming Call Screen (foreground only) -->
        <activity
            android:name=".ui.activity.IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <!-- Call Session Screen -->
        <activity
            android:name=".ui.activity.CallActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation" />

        <!-- FCM Service -->
        <service
            android:name=".fcm.AppFCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
