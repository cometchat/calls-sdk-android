<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_background"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.cometchat.samplecallsringing.ui.views.AvatarView
        android:id="@+id/img_avatar"
        android:layout_width="128dp"
        android:layout_height="128dp" />

    <TextView
        android:id="@+id/tv_caller_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="@color/call_text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_incoming_call"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/incoming_call"
        android:textColor="@color/call_text_secondary"
        android:textSize="16sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_reject"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle_red"
            android:contentDescription="@string/reject"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_call_reject" />

        <View
            android:layout_width="80dp"
            android:layout_height="0dp" />

        <ImageButton
            android:id="@+id/btn_accept"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle_green"
            android:contentDescription="@string/accept"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_call_accept" />

    </LinearLayout>

</LinearLayout>
